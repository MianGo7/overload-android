<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".OverloadApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Overload">

        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.goal.GoalActivity"
            android:exported="false"
            android:label="@string/goal_title"
            android:parentActivityName=".ui.dashboard.DashboardActivity" />

        <activity
            android:name=".ui.logentry.LogEntryActivity"
            android:exported="false"
            android:label="@string/log_title"
            android:parentActivityName=".ui.dashboard.DashboardActivity" />

        <activity
            android:name=".ui.history.HistoryActivity"
            android:exported="false"
            android:label="@string/history_title"
            android:parentActivityName=".ui.dashboard.DashboardActivity" />

        <activity
            android:name=".ui.history.WeekDetailActivity"
            android:exported="false"
            android:label="@string/week_detail_title"
            android:parentActivityName=".ui.history.HistoryActivity" />
    </application>

</manifest>
